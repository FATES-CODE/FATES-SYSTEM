# 포트 설정
PORT=3000

# 문의 수신 대상 이메일 주소
TARGET_EMAIL=azamino.ltd@gmail.com

# Gmail SMTP 발송 계정 정보 (실제 메일 발송 시 설정)
# 1. Google 계정 관리 -> 보안 -> 2단계 인증 활성화
# 2. '앱 비밀번호(App Password)' 생성 (16자리)
# 3. 아래 항목에 발신용 이메일과 앱 비밀번호 입력
GMAIL_USER=azamino.ltd@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password_here
